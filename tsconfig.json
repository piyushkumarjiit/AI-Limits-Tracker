{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "server",
    "web",
    "extension",
    "landing",
    "integrations",
    "tests/remote.test.ts",
    "tests/security_tests.ts",
    "tests/security_hardening_tests.ts",
    "tests/session_hardening_tests.ts",
    "tests/final_hardening_tests.ts",
    "tests/deploy_config_tests.ts",
    "tests/antigravity_oauth_tests.ts",
    "tests/antigravity_parser_tests.ts",
    "tests/antigravity_provider_tests.ts",
    "tests/capacity_tests.ts",
    "tests/family_rn_tests.ts",
    "tests/cpa_transport_tests.ts",
    "tests/cpa_routing_planner_tests.ts",
    "tests/cpa_provider_tests.ts",
    "tests/cpa_sync_tests.ts",
    "tests/cpa_routing_exec_tests.ts"
  ]
}

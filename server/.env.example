# ---- AI Limits Tracker server ----
# Copy to .env and fill in. Never commit the real .env.

# Password for the web panel (required). Choose a unique password, at least 32
# characters is recommended. Generate: openssl rand -hex 32
# (Placeholder values such as change-me are rejected at startup.)
ADMIN_PASSWORD=

# Secret used to encrypt stored credentials (16+ random chars; keep it stable!
# changing it makes existing accounts unreadable). Generate: openssl rand -hex 32
APP_SECRET=

# Port the Node server listens on (nginx proxies to it)
PORT=8795
# Bind to loopback behind nginx; set 0.0.0.0 explicitly for a container/network listener.
HOST=127.0.0.1

# Optional comma-separated allowlist of Host header names. Only the hostname is
# compared (any port and IPv6 brackets are ignored); requests for another Host
# are refused with 421. Leave empty to accept any Host. Requires a restart.
# ALLOWED_HOSTS=tracker.example.com

# How often to poll all accounts, minutes (can be changed later in the UI)
POLL_INTERVAL_MIN=10

# How long a web-panel sign-in stays valid, in days (whole number, 1-365).
# Defaults to 30. Changing it does not end sessions already issued; POST
# /api/sessions/revoke-all (authenticated) ends every existing session.
# SESSION_DAYS=30

# Where the SQLite database is stored
DATA_DIR=/opt/ai-limits-tracker/data

# Built web panel (served by the same server)
WEB_DIR=/opt/ai-limits-tracker/web/dist

# Optional: machine-to-machine token for the API (extension / scripts)
# Must be at least 24 chars. Generate: openssl rand -hex 32
# API_TOKEN=

# Optional: Telegram alerts on low limits / reset / re-login
# Create a bot via @BotFather, get your chat id from @userinfobot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional custom Google OAuth client for Antigravity (optional overrides; leave unset to use Antigravity's public client).
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Optional: CLIProxyAPI (CPA) integration for multi-account quota tracking
# Base URL for CPA management endpoint (e.g., http://127.0.0.1:8313 or http://10.0.0.5:8313 or https://cpa.example.com).
# Plain http: is only permitted for loopback (127.0.0.1, localhost) or RFC1918 private network addresses.
# CPA_BASE_URL=http://127.0.0.1:8313
# Management key configured on CPA (Bearer token).
# CPA_MANAGEMENT_KEY=
# CPA request timeout in milliseconds (1000-60000, default 10000).
# CPA_TIMEOUT_MS=10000
# Background poll interval in seconds (5-3600, default 60).
# CPA_POLL_INTERVAL_SEC=60

# Copy to .env and fill in before `docker compose up -d`.

# Password for the web panel (required).
ADMIN_PASSWORD=change-me

# Random string, 16+ chars. Encrypts stored session credentials; changing it makes
# existing accounts unreadable, so keep a backup. Generate with: openssl rand -hex 32
APP_SECRET=

# Optional long random token for scripted access: Authorization: Bearer <token>
API_TOKEN=

# Optional Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to 1 only when a reverse proxy in front of the container sets X-Real-IP.
TRUST_PROXY=0

# Host port to publish the panel on (default 1455).
PORT=1455

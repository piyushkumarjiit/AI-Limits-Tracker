# Copy to .env and fill in before `docker compose --profile <public|internal|direct> up -d`.

# Password for the web panel (required). Choose a unique password, at least 32
# characters is recommended. Generate one with: openssl rand -hex 32
# (Placeholder values such as change-me are rejected at startup.)
ADMIN_PASSWORD=

# Random string, 16+ chars. Encrypts stored session credentials; changing it makes
# existing accounts unreadable, so keep a backup. Generate with: openssl rand -hex 32
APP_SECRET=

# Optional long random token for scripted access: Authorization: Bearer <token>
# Must be at least 24 chars. Generate with: openssl rand -hex 32
API_TOKEN=

# Optional separate token for GET /metrics (Prometheus). Falls back to API_TOKEN;
# /metrics returns 404 when neither is set. At least 24 chars.
# METRICS_TOKEN=

# Optional Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional custom Google OAuth client for Antigravity (optional overrides; leave unset to use Antigravity's public client).
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Optional: CLIProxyAPI (CPA) integration for multi-account quota tracking
# Base URL for CPA management endpoint (e.g., http://127.0.0.1:8313 or http://10.0.0.5:8313 or https://cpa.example.com).
# Plain http: is only permitted for loopback (127.0.0.1, localhost) or RFC1918 private network addresses.
# CPA_BASE_URL=http://127.0.0.1:8313
# Management key configured on CPA (Bearer token).
# CPA_MANAGEMENT_KEY=
# CPA request timeout in milliseconds (1000-60000, default 10000).
# CPA_TIMEOUT_MS=10000
# Background poll interval in seconds (5-3600, default 60).
# CPA_POLL_INTERVAL_SEC=60
#
# Per-request token usage (CLIProxy v8+): enable usage-statistics-enabled in the
# CLIProxy config; FQD polls its 60-second usage queue at this interval.
# CPA_USAGE_POLL_SEC=20
#
# Routing mode: off, shadow (default: log decisions only) or enforce (set weight 0
# and disable exhausted accounts in CLIProxy; needs its weighted round-robin strategy).
# Overrides the mode in the policy file.
# CPA_ROUTING_MODE=shadow
#
# Optional tuning for quota reset recovery polling (ResetRecoveryWatcher):
# Tick interval in seconds (default 30).
# RESET_RECOVERY_TICK_SEC=30
# Minimum seconds between watcher-requested syncAll polls (default 60).
# RESET_RECOVERY_MIN_POLL_GAP_SEC=60
# Clock skew buffer in seconds added to reset timestamps (default 60).
# RESET_RECOVERY_CLOCK_SKEW_SEC=60
# Comma-separated retry ladder in seconds when probes fail (default 120,300,900).
# RESET_RECOVERY_RETRY_LADDER_SEC=120,300,900
#
# Optional: LiteLLM per-model usage from spend logs. The key needs proxy_admin_viewer read
# access (only use a  READ ONLY user created with user_role "proxy_admin_viewer").
# LITELLM_URL=http://127.0.0.1:4000
# LITELLM_KEY=
# Path to the routing policy YAML (optional; defaults to /app/config/policy.yaml,
# /opt/agentic-services/tracker/watermark-policy.yaml, or ./watermark-policy.yaml).
# It sets the tight / exhausted levels and account tiers; see deploy/policy.example.yaml.
# Without a file FQD uses the defaults shown in that example.
# CPA_WATERMARK_POLICY_FILE=/app/config/policy.yaml

# Direct mode (Caddy off) only: set to 1 only when your own reverse proxy sets
# X-Real-IP. The Caddy profiles always run the app with TRUST_PROXY=1.
TRUST_PROXY=0

# Caddy modes: address Caddy serves. public = your DNS name (Let's Encrypt);
# internal = LAN IP or local name (Caddy internal CA). Keep ALLOWED_HOSTS in line.
# SITE_ADDRESS=tracker.example.com
# Host ports Caddy publishes (defaults 80 / 443). In public mode leave them at
# 80 / 443: Let's Encrypt validates and renews on those ports.
# HTTP_PORT=80
# HTTPS_PORT=443

# How long a web-panel sign-in stays valid, in days (whole number, 1-365).
# Defaults to 30. Changing it does not end sessions already issued; POST
# /api/sessions/revoke-all (authenticated) ends every existing session.
# SESSION_DAYS=30

# Optional comma-separated allowlist of Host header names. Only the hostname is
# compared (any port and IPv6 brackets are ignored); requests for another Host
# are refused with 421. Leave empty to accept any Host. Requires a restart.
# ALLOWED_HOSTS=tracker.example.com

# Direct mode only: host port to publish the app on (default 1455).
PORT=1455
